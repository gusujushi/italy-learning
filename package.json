{
  "name": "italy-learning",
  "version": "0.2.0",
  "private": true,
  "description": "意大利语能力岛：90 天从零开始的听说读写学习程序（每课 6 步学习法、彩色句子分析、可调学习计划；纯静态，无需构建）",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "validate": "node tools/validate.js",
    "e2e": "node tests/e2e/flow.js",
    "e2e:all": "node tests/e2e/all-days.js",
    "screenshots": "node tests/e2e/screenshots.js",
    "icons": "python3 tools/make_icons.py",
    "serve": "python3 -m http.server 8080"
  },
  "engines": {
    "node": ">=18"
  }
}
